  storyimage:
  - {fileID: 21300000, guid: caced089e0c00494e91058f08c181310, type: 3}
  julguritext:
  - "\uC624\uB298\uC758 \uC774\uC57C\uAE30\uB97C \uC2DC\uC791\uD574\uBCF4\uC790..."
  - "\uC774\uC57C\uAE30\uC758 \uC8FC\uC778\uACF5 \uC694\uC2DC\uD788\uB370\uB294,
    \uC2E4\uB825\uC774 \uCD9C\uC911\uD55C \uD654\uAC00\uC9C0\uB9CC \uD3C9\uD310\uC774
    \uAD49\uC7A5\uD788 \uB098\uBE74\uB2E4."
  - "\uC694\uC2DC\uD788\uB370\uC5D0\uAC90 \uB054\uCC0D\uD788\uB3C4 \uC544\uB07C\uB294
    \uB538\uC774 \uC788\uC5C8\uB2E4. \uC2DC\uB140\uB85C \uC77C\uD558\uB294 \uB538\uC740
    \uC694\uC2DC\uD788\uB370\uC640\uB294 \uB2EC\uB9AC \uACE7\uC740 \uC131\uD488\uC73C\uB85C
    \uB9CE\uC740 \uC0AC\uB791\uC744 \uBC1B\uC544\uC654\uB2E4."
  - "\uC694\uC2DC\uD788\uB370\uB294 \uC601\uC8FC\uC5D0\uAC8C \uB538\uC744 \uB3CC\uB824\uBCF4\uB0B4\uB2EC\uB77C\uACE0
    \uC9C0\uC18D\uC801\uC73C\uB85C \uBD80\uD0C1\uD574\uC654\uB2E4. \uC601\uC8FC\uB294
    \uC774\uC5D0 \uC9C8\uB824 \uC694\uC2DC\uD788\uB370\uC5D0\uAC8C \uD55C\uAC00\uC9C0
    \uC2DC\uD5D8\uC744 \uB0B4\uB9B0\uB2E4."
  - '*'
  - "\uADF8\uAC83\uC740 \uC9C0\uC625\uC758 \uBAA8\uC2B5\uC744 \uADF8\uB9AC\uB77C\uB294
    \uBA85\uB839. \uC694\uC2DC\uD788\uB370\uB294 \uADF8\uB0A0 \uC774\uD6C4\uB85C
    \uBCD1\uD48D\uC744 \uADF8\uB9AC\uB294 \uAC83\uC5D0\uB9CC \uC804\uB150\uD558\uC600\uB2E4."
  - "#\uC9C0\uC625\uC744 \uC9C1\uC811 \uBC14\uB77C\uBCF4\uC544\uC57C \uC9C0\uC625\uC744
    \uADF8\uB9B4 \uC218 \uC788\uB2E4. \uADF8\uB807\uAC8C \uC0DD\uAC01\uD55C \uC694\uC2DC\uD788\uB370\uB294
    \uC81C\uC790\uB4E4\uC744 \uBD88\uB7EC \uC704\uD5D8\uD55C \uACE0\uBB38\uC744 \uAC10\uD589\uD588\uB2E4."
  - "\uBCD1\uD48D\uC744 \uADF8\uB824\uB098\uAC00\uB358 \uC5B4\uB290\uB0A0, \uC694\uC2DC\uD788\uB370\uB294
    \uC601\uC8FC\uB97C \uCC3E\uC544\uAC00 \uB9D0\uD558\uC600\uB2E4."
  - "\uC5B4\uCA50\uC9C0 \uADF8 \uB9D0\uC744 \uB4E4\uC740 \uC601\uC8FC\uC758 \uC5BC\uAD74\uC5D4
    \uC694\uC2DC\uD788\uB370\uC758 \uAD11\uAE30\uC640 \uAC19\uC740 \uC6C3\uC74C\uAF43\uC774
    \uD53C\uC5B4\uC788\uC5C8\uB2E4."
  - "#\uBD88\uD0C0\uB294 \uB9C8\uCC28\uC758 \uC548\uC5D0\uB294 \uC694\uC2DC\uD788\uB370\uC758
    \uB538\uC774 \uD0C0\uACE0 \uC788\uC5C8\uB2E4. \uADF8\uB7EC\uB098..."
  - "\uC694\uC2DC\uD788\uB370\uB294 \uD669\uD640\uACBD\uC5D0 \uC816\uC740 \uB208\uC73C\uB85C
    \uB9C8\uCC28\uB97C \uADF8\uC800 \uC9C0\uCF1C\uBCF4\uACE0\uB9CC \uC788\uC744 \uBFD0\uC774\uC600\uB2E4."
  - "\uC5BC\uB9C8 \uD6C4, \uBCD1\uD48D\uC740 \uC644\uC131\uB418\uC5C8\uB2E4. \uADF8\uB9AC\uACE0
    \uC694\uC2DC\uD788\uB370\uB294, \uBAA9\uC744 \uB9E4\uB2EC\uC544 \uC790\uC0B4\uD558\uC600\uB2E4."
  fightscene:
